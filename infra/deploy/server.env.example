POSTGRES_DB=forgemind
POSTGRES_USER=forgemind
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://forgemind:replace-with-strong-password@postgres:5432/forgemind?schema=public
FORGEMIND_DB_CONNECTION_LIMIT=10
FORGEMIND_DB_POOL_TIMEOUT_SECONDS=30

NODE_ENV=production
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

FORGEMIND_CREDENTIAL_KEY=replace-with-base64-32-byte-key
FORGEMIND_WORKER_MODE=daemon
FORGEMIND_WORKER_STOP_WHEN_IDLE=false
FORGEMIND_WORKER_POLL_MS=2500
FORGEMIND_WORKSPACE_ROOT=/data/workspaces
FORGEMIND_GIT_AUTHOR_NAME=ForgeMind Worker
FORGEMIND_GIT_AUTHOR_EMAIL=forgemind-worker@users.noreply.github.com
FORGEMIND_QUEUE_CLAIM_TIMEOUT_MINUTES=2
FORGEMIND_CODEX_HOME=/data/codex
CODEX_HOME=/data/codex
CODEX_EXEC_INACTIVITY_TIMEOUT_MS=600000
CODEX_EXEC_MAX_RUNTIME_MS=3600000

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CALLBACK_URL=https://myrunning.duckdns.org:8443/api/auth/github/callback

VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
