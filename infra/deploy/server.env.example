POSTGRES_DB=forgemind
POSTGRES_USER=forgemind
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://forgemind:replace-with-strong-password@postgres:5432/forgemind?schema=public
FORGEMIND_DB_CONNECTION_LIMIT=10
FORGEMIND_DB_POOL_TIMEOUT_SECONDS=30

NODE_ENV=production
HOST=0.0.0.0
PORT=4000
FORGEMIND_INTERNAL_API_URL=http://api:4000
LOG_LEVEL=info

FORGEMIND_CREDENTIAL_KEY=replace-with-base64-32-byte-key
FORGEMIND_AUTH_SESSION_SECRET=replace-with-long-random-session-secret
FORGEMIND_SESSION_COOKIE_SECURE=true
FORGEMIND_CORS_ORIGINS=https://forgemind.example.com
FORGEMIND_AUTH_RETURN_URL=https://forgemind.example.com/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://forgemind.example.com/api/auth/google/callback
# Exact Google account email allowed to administer this single-owner instance.
FORGEMIND_GOOGLE_ALLOWED_EMAIL=owner@example.com
FORGEMIND_WORKER_MODE=daemon
FORGEMIND_WORKER_STOP_WHEN_IDLE=false
FORGEMIND_WORKER_POLL_MS=2500
# Comma-separated non-installable runtime capabilities exposed by this worker.
# Platform capabilities (linux/windows/macos) are detected automatically.
FORGEMIND_WORKER_CAPABILITIES=
FORGEMIND_WORKSPACE_ROOT=/data/workspaces
FORGEMIND_GIT_AUTHOR_NAME=ForgeMind Worker
FORGEMIND_GIT_AUTHOR_EMAIL=forgemind-worker@users.noreply.github.com
FORGEMIND_QUEUE_CLAIM_TIMEOUT_MINUTES=2
FORGEMIND_CODEX_HOME=/data/codex
CODEX_HOME=/data/codex
CODEX_EXEC_INACTIVITY_TIMEOUT_MS=600000
CODEX_EXEC_MAX_RUNTIME_MS=3600000

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=

# Push notifications require both keys before `/api/notifications/vapid-public-key` works.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
