NODE_ENV=development
PORT=4000
FORGEMIND_INTERNAL_API_URL=http://127.0.0.1:4000
DATABASE_URL=postgresql://forgemind:forgemind@127.0.0.1:5432/forgemind?schema=public
REDIS_URL=redis://localhost:6379
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
FORGEMIND_GITHUB_ADAPTER=mock
FORGEMIND_CREDENTIAL_KEY=
FORGEMIND_AUTH_SESSION_SECRET=
FORGEMIND_SESSION_COOKIE_SECURE=false
FORGEMIND_CORS_ORIGINS=http://localhost:5173
FORGEMIND_AUTH_RETURN_URL=http://localhost:5173/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
FORGEMIND_GOOGLE_ALLOWED_EMAIL=
FORGEMIND_PROVIDER=mock
FORGEMIND_VERIFY_COMMAND=node --version
FORGEMIND_CODEX_CLI_PATH=
CODEX_EXEC_INACTIVITY_TIMEOUT_MS=600000
CODEX_EXEC_MAX_RUNTIME_MS=3600000
