generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  operator
}

enum TaskMode {
  safe
  auto
  full_auto
}

enum TaskStatus {
  draft
  submitted
  planning
  creating_github_issue
  creating_branch
  running_ai
  validating
  reviewing
  improving
  creating_pr
  ready_for_user_review
  completed
  failed
  cancelled
  provider_failed
  validation_failed
}

enum ProviderKind {
  codex
  github_copilot
  openai
}

enum RunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum QueueJobStatus {
  pending
  claimed
  succeeded
  failed
  cancelled
}

enum WorkerDeviceStatus {
  offline
  idle
  reserved
  running
  draining
  revoked
}

enum WorkerSessionStatus {
  active
  draining
  cancelled
  expired
  closed
}

enum ExecutionJobStatus {
  queued
  leased
  running
  succeeded
  failed
  cancelled
  expired
}

enum ExecutionLeaseStatus {
  active
  released
  expired
  cancelled
}

enum IterationPhase {
  planning
  implementation
  validation
  review
  pr_creation
}

enum AuditActorType {
  user
  agent
  system
  github
}

enum AiProviderAuthMode {
  api_key
  codex_oauth
}

enum ChatThreadStatus {
  active
  archived
}

enum ChatRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
  interrupted
}

enum ChatMessageRole {
  user
  assistant
  system
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  githubUserId  String?  @unique @map("github_user_id")
  googleSubject String?  @unique @map("google_subject")
  role          UserRole @default(owner)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tasks                     Task[]
  notificationSettings      NotificationSettings?
  notificationSubscriptions NotificationSubscription[]
  githubConnection          GitHubConnection?
  aiProviderConnections     AiProviderConnection[]
  chatThreads               ChatThread[]
  authSessions              AuthSession[]

  @@map("users")
}

model AuthSession {
  tokenHash  String    @id @map("token_hash")
  userId     String    @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Project {
  id                                 String        @id @default(uuid())
  name                               String
  slug                               String        @unique
  githubOwner                        String?       @map("github_owner")
  githubRepo                         String?       @map("github_repo")
  defaultBranch                      String        @default("main") @map("default_branch")
  configYaml                         String?       @map("config_yaml")
  brief                              String?
  projectContract                    Json?         @map("project_contract")
  currentContractVersionId           String?       @unique @map("current_contract_version_id")
  projectMemory                      Json?         @map("project_memory")
  projectArchitecture                Json?         @map("project_architecture")
  currentArchitectureVersionId       String?       @unique @map("current_architecture_version_id")
  planningSessionId                  String?       @map("planning_session_id")
  planningSessionProvider            ProviderKind? @map("planning_session_provider")
  planningSessionModel               String?       @map("planning_session_model")
  planningSessionConnectionId        String?       @map("planning_session_connection_id")
  planningSessionUpdatedAt           DateTime?     @map("planning_session_updated_at")
  autoCreatePullRequest              Boolean       @default(true) @map("auto_create_pull_request")
  autoMergePullRequest               Boolean       @default(false) @map("auto_merge_pull_request")
  autoCompleteTask                   Boolean       @default(false) @map("auto_complete_task")
  defaultTaskMode                    TaskMode      @default(safe) @map("default_task_mode")
  aiProviderConnectionId             String?       @map("ai_provider_connection_id")
  isActive                           Boolean       @default(true) @map("is_active")
  createdAt                          DateTime      @default(now()) @map("created_at")
  updatedAt                          DateTime      @updatedAt @map("updated_at")

  tasks                      Task[]
  auditLog                   AuditLog[]
  roadmapCycles              ProjectRoadmapCycle[]
  specificationVersions      ProjectSpecificationVersion[]
  contractVersions           ProjectContractVersion[]      @relation("ProjectContractVersions")
  currentContractVersion     ProjectContractVersion?       @relation("CurrentProjectContractVersion", fields: [currentContractVersionId], references: [id], onDelete: SetNull)
  architectureVersions       ProjectArchitectureVersion[]  @relation("ProjectArchitectureVersions")
  currentArchitectureVersion ProjectArchitectureVersion?   @relation("CurrentProjectArchitectureVersion", fields: [currentArchitectureVersionId], references: [id], onDelete: SetNull)
  roadmapSteps               ProjectImplementationStep[]
  acceptanceEvidence         AcceptanceEvidence[]
  auditJobs                  ProjectAuditJob[]
  aiProviderConnection       AiProviderConnection?         @relation(fields: [aiProviderConnectionId], references: [id], onDelete: SetNull)
  chatThreads                ChatThread[]
  windowsExecutionJobs       WindowsExecutionJob[]

  @@map("projects")
}

enum ProjectRoadmapCycleStatus {
  active
  verifying
  partial
  blocked
  awaiting_extension_decision
  completed
}

enum ProjectArchitectureVersionSource {
  initial_plan
  approved_extension
  task_update
  legacy_import
}

enum ProjectAuditJobStatus {
  pending
  claimed
  succeeded
  blocked
  failed
}

enum ProjectImplementationStepStatus {
  pending
  running
  completed
  cancelled
}

enum ProjectSpecificationSource {
  initial_brief
  approved_extension
  manual_revision
}

enum ProjectContractVersionSource {
  initial_plan
  approved_extension
  manual_regeneration
}

enum AcceptanceEvidenceSource {
  validation_command
  github_check
  repository_audit
  artifact
}

enum AcceptanceEvidenceStatus {
  passed
  failed
  blocked
  deferred
}

model GitHubConnection {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  tokenCiphertext  String    @map("token_ciphertext")
  tokenFingerprint String    @map("token_fingerprint")
  apiBaseUrl       String    @default("https://api.github.com") @map("api_base_url")
  connectedAt      DateTime  @default(now()) @map("connected_at")
  lastCheckedAt    DateTime? @map("last_checked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("github_connections")
}

model AiProviderConnection {
  id                String             @id @default(uuid())
  userId            String             @map("user_id")
  name              String
  isDefault         Boolean            @default(false) @map("is_default")
  provider          ProviderKind
  authMode          AiProviderAuthMode @default(api_key) @map("auth_mode")
  model             String
  apiKeyCiphertext  String?            @map("api_key_ciphertext")
  apiKeyFingerprint String?            @map("api_key_fingerprint")
  codexHome         String?            @map("codex_home")
  accountSummary    String?            @map("account_summary")
  connectedAt       DateTime           @default(now()) @map("connected_at")
  lastCheckedAt     DateTime?          @map("last_checked_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id])
  projects    Project[]
  chatThreads ChatThread[]

  @@unique([userId, name])
  @@index([userId, isDefault])
  @@map("ai_provider_connections")
}

model ChatThread {
  id                          String           @id @default(uuid())
  userId                      String           @map("user_id")
  projectId                   String?          @map("project_id")
  providerConnectionId        String?          @map("provider_connection_id")
  title                       String
  status                      ChatThreadStatus @default(active)
  mode                        TaskMode         @default(safe)
  repositoryOwner             String?          @map("repository_owner")
  repositoryName              String?          @map("repository_name")
  baseBranch                  String?          @map("base_branch")
  branchName                  String?          @map("branch_name")
  contextSummary              String?          @map("context_summary")
  providerSessionId           String?          @map("provider_session_id")
  providerSessionProvider     ProviderKind?    @map("provider_session_provider")
  providerSessionModel        String?          @map("provider_session_model")
  providerSessionConnectionId String?          @map("provider_session_connection_id")
  providerSessionUpdatedAt    DateTime?        @map("provider_session_updated_at")
  lastMessageAt               DateTime?        @map("last_message_at")
  archivedAt                  DateTime?        @map("archived_at")
  createdAt                   DateTime         @default(now()) @map("created_at")
  updatedAt                   DateTime         @updatedAt @map("updated_at")

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  providerConnection AiProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  messages           ChatMessage[]
  runs               ChatRun[]
  auditLog           AuditLog[]

  @@index([userId, status, updatedAt])
  @@index([projectId])
  @@map("chat_threads")
}

model ChatRun {
  id              String        @id @default(uuid())
  threadId        String        @map("thread_id")
  status          ChatRunStatus @default(queued)
  prompt          String
  provider        ProviderKind?
  model           String?
  attemptCount    Int           @default(0) @map("attempt_count")
  inputTokens     Int           @default(0) @map("input_tokens")
  outputTokens    Int           @default(0) @map("output_tokens")
  totalTokens     Int           @default(0) @map("total_tokens")
  cachedTokens    Int           @default(0) @map("cached_tokens")
  actualCostUsd   Decimal?      @map("actual_cost_usd") @db.Decimal(10, 4)
  errorMessage    String?       @map("error_message")
  responseSummary String?       @map("response_summary")
  resultJson      Json?         @map("result_json")
  stopRequested   Boolean       @default(false) @map("stop_requested")
  nextAttemptAt   DateTime?     @map("next_attempt_at")
  claimedAt       DateTime?     @map("claimed_at")
  heartbeatAt     DateTime?     @map("heartbeat_at")
  startedAt       DateTime?     @map("started_at")
  finishedAt      DateTime?     @map("finished_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  thread    ChatThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  auditLog  AuditLog[]

  @@index([status, nextAttemptAt, createdAt])
  @@index([threadId, createdAt])
  @@map("chat_runs")
}

model ChatMessage {
  id           String          @id @default(uuid())
  threadId     String          @map("thread_id")
  runId        String?         @map("run_id")
  sequence     Int
  role         ChatMessageRole
  content      String
  metadataJson Json?           @map("metadata_json")
  createdAt    DateTime        @default(now()) @map("created_at")

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  run    ChatRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([threadId, sequence])
  @@index([threadId, createdAt])
  @@index([runId])
  @@map("chat_messages")
}

model NotificationSettings {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  pushEnabled      Boolean  @default(false) @map("push_enabled")
  taskUpdates      Boolean  @default(true) @map("task_updates")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notification_settings")
}

model NotificationSubscription {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  endpoint   String
  keysJson   Json?    @map("keys_json")
  deviceName String?  @map("device_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("notification_subscriptions")
}

model Task {
  id                             String        @id @default(uuid())
  projectId                      String        @map("project_id")
  createdByUserId                String        @map("created_by_user_id")
  title                          String
  prompt                         String
  acceptanceCriteria             Json          @default("[]") @map("acceptance_criteria")
  mode                           TaskMode      @default(safe)
  status                         TaskStatus    @default(draft)
  deferredValidationCapabilities Json          @default("[]") @map("deferred_validation_capabilities")
  githubIssueNumber              Int?          @map("github_issue_number")
  githubIssueUrl                 String?       @map("github_issue_url")
  branchName                     String?       @map("branch_name")
  architectureVersionId          String?       @map("architecture_version_id")
  pullRequestNumber              Int?          @map("pull_request_number")
  pullRequestUrl                 String?       @map("pull_request_url")
  providerSessionId              String?       @map("provider_session_id")
  providerSessionProvider        ProviderKind? @map("provider_session_provider")
  providerSessionModel           String?       @map("provider_session_model")
  providerSessionConnectionId    String?       @map("provider_session_connection_id")
  providerSessionUpdatedAt       DateTime?     @map("provider_session_updated_at")
  createdAt                      DateTime      @default(now()) @map("created_at")
  updatedAt                      DateTime      @updatedAt @map("updated_at")
  startedAt                      DateTime?     @map("started_at")
  finishedAt                     DateTime?     @map("finished_at")

  project                    Project                      @relation(fields: [projectId], references: [id])
  createdByUser              User                         @relation(fields: [createdByUserId], references: [id])
  taskRuns                   TaskRun[]
  queueJobs                  TaskQueueJob[]
  providerUsage              ProviderUsage[]
  auditLog                   AuditLog[]
  roadmapSteps               ProjectImplementationStep[]
  architectureVersion        ProjectArchitectureVersion?  @relation("TaskEffectiveArchitecture", fields: [architectureVersionId], references: [id], onDelete: SetNull)
  sourceArchitectureVersions ProjectArchitectureVersion[] @relation("ArchitectureSourceTask")
  acceptanceEvidence         AcceptanceEvidence[]
  checkpoints                TaskCheckpoint[]
  windowsExecutionJobs       WindowsExecutionJob[]

  @@index([projectId, status])
  @@map("tasks")
}

model WorkerDevice {
  id                String             @id @default(uuid())
  schemaVersion     Int                @default(1) @map("schema_version")
  platform          String
  runnerVersion     String             @map("runner_version")
  displayName       String             @map("display_name")
  status            WorkerDeviceStatus @default(offline)
  capabilities      Json               @default("[]")
  probeEvidence     Json               @default("[]") @map("probe_evidence")
  metadata          Json               @default("{}")
  lastHeartbeatAt   DateTime?           @map("last_heartbeat_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  sessions    WorkerSession[]
  leases      WindowsExecutionLease[]
  enrollments WorkerEnrollment[]
  credentials WorkerCredential[]

  @@index([status, lastHeartbeatAt])
  @@map("worker_devices")
}

model WorkerEnrollment {
  id        String    @id @default(uuid())
  deviceId  String    @map("device_id")
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  device WorkerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, expiresAt])
  @@map("worker_enrollments")
}

model WorkerCredential {
  id        String    @id @default(uuid())
  deviceId  String    @map("device_id")
  tokenHash String    @unique @map("token_hash")
  scope     String
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  device WorkerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, revokedAt])
  @@map("worker_credentials")
}

model WorkerSession {
  id              String              @id @default(uuid())
  schemaVersion   Int                 @default(1) @map("schema_version")
  deviceId        String              @map("device_id")
  status          WorkerSessionStatus @default(active)
  startedAt       DateTime            @default(now()) @map("started_at")
  expiresAt       DateTime            @map("expires_at")
  lastHeartbeatAt DateTime            @default(now()) @map("last_heartbeat_at")
  endedAt         DateTime?           @map("ended_at")

  device WorkerDevice             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  leases WindowsExecutionLease[]

  @@index([deviceId, status, expiresAt])
  @@map("worker_sessions")
}

model WindowsExecutionJob {
  id                   String             @id @default(uuid())
  schemaVersion        Int                @default(1) @map("schema_version")
  projectId            String             @map("project_id")
  taskId               String             @map("task_id")
  runId                String             @map("run_id")
  status               ExecutionJobStatus @default(queued)
  requiredCapabilities Json               @default("[]") @map("required_capabilities")
  packet               Json
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  project Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run     TaskRun                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  leases  WindowsExecutionLease[]

  @@index([status, createdAt])
  @@index([taskId, status])
  @@map("windows_execution_jobs")
}

model WindowsExecutionLease {
  id            String               @id @default(uuid())
  schemaVersion Int                  @default(1) @map("schema_version")
  jobId         String               @map("job_id")
  deviceId      String               @map("device_id")
  sessionId     String               @map("session_id")
  status        ExecutionLeaseStatus @default(active)
  claimedAt     DateTime             @default(now()) @map("claimed_at")
  expiresAt     DateTime             @map("expires_at")
  nonce         String
  releasedAt    DateTime?            @map("released_at")

  job     WindowsExecutionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  device  WorkerDevice       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  session WorkerSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([sessionId, status])
  @@unique([sessionId, nonce])
  @@map("windows_execution_leases")
}

model ProjectRoadmapCycle {
  id                     String                    @id @default(uuid())
  projectId              String                    @map("project_id")
  specificationVersionId String?                   @map("specification_version_id")
  contractVersionId      String?                   @map("contract_version_id")
  architectureVersionId  String?                   @map("architecture_version_id")
  cycleNumber            Int                       @map("cycle_number")
  objective              String
  extensionProposal      String?                   @map("extension_proposal")
  status                 ProjectRoadmapCycleStatus @default(active)
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  completedAt            DateTime?                 @map("completed_at")

  project                       Project                      @relation(fields: [projectId], references: [id])
  specificationVersion          ProjectSpecificationVersion? @relation("RoadmapCycleSpecification", fields: [specificationVersionId], references: [id], onDelete: SetNull)
  contractVersion               ProjectContractVersion?      @relation("RoadmapCycleContract", fields: [contractVersionId], references: [id], onDelete: SetNull)
  architectureVersion           ProjectArchitectureVersion?  @relation("RoadmapCycleArchitecture", fields: [architectureVersionId], references: [id], onDelete: SetNull)
  generatedSpecificationVersion ProjectSpecificationVersion? @relation("SpecificationSourceCycle")
  steps                         ProjectImplementationStep[]
  acceptanceEvidence            AcceptanceEvidence[]
  auditJobs                     ProjectAuditJob[]

  @@unique([projectId, cycleNumber])
  @@index([projectId, status])
  @@map("project_roadmap_cycles")
}

model ProjectSpecificationVersion {
  id                String                     @id @default(uuid())
  projectId         String                     @map("project_id")
  version           Int
  fullSpecification String                     @map("full_specification")
  changeSummary     String                     @map("change_summary")
  source            ProjectSpecificationSource
  parentVersionId   String?                    @map("parent_version_id")
  sourceCycleId     String?                    @unique @map("source_cycle_id")
  approvedAt        DateTime?                  @map("approved_at")
  createdAt         DateTime                   @default(now()) @map("created_at")

  project          Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentVersion    ProjectSpecificationVersion?  @relation("SpecificationVersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions    ProjectSpecificationVersion[] @relation("SpecificationVersionParent")
  sourceCycle      ProjectRoadmapCycle?          @relation("SpecificationSourceCycle", fields: [sourceCycleId], references: [id], onDelete: SetNull)
  roadmapCycles    ProjectRoadmapCycle[]         @relation("RoadmapCycleSpecification")
  contractVersions ProjectContractVersion[]

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@map("project_specification_versions")
}

model ProjectContractVersion {
  id                     String                       @id @default(uuid())
  projectId              String                       @map("project_id")
  specificationVersionId String?                      @map("specification_version_id")
  version                Int
  contractJson           Json                         @map("contract_json")
  contractDelta          Json?                        @map("contract_delta")
  changeSummary          String                       @map("change_summary")
  source                 ProjectContractVersionSource
  parentVersionId        String?                      @map("parent_version_id")
  createdAt              DateTime                     @default(now()) @map("created_at")

  project              Project                      @relation("ProjectContractVersions", fields: [projectId], references: [id], onDelete: Cascade)
  currentForProject    Project?                     @relation("CurrentProjectContractVersion")
  specificationVersion ProjectSpecificationVersion? @relation(fields: [specificationVersionId], references: [id], onDelete: SetNull)
  parentVersion        ProjectContractVersion?      @relation("ProjectContractVersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions        ProjectContractVersion[]     @relation("ProjectContractVersionParent")
  roadmapCycles        ProjectRoadmapCycle[]        @relation("RoadmapCycleContract")
  architectureVersions ProjectArchitectureVersion[]

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@map("project_contract_versions")
}

model ProjectArchitectureVersion {
  id                 String                           @id @default(uuid())
  projectId          String                           @map("project_id")
  version            Int
  architectureJson   Json                             @map("architecture_json")
  architectureUpdate Json?                            @map("architecture_update")
  changeSummary      String                           @map("change_summary")
  source             ProjectArchitectureVersionSource
  parentVersionId    String?                          @map("parent_version_id")
  contractVersionId  String?                          @map("contract_version_id")
  sourceTaskId       String?                          @unique @map("source_task_id")
  createdAt          DateTime                         @default(now()) @map("created_at")

  project           Project                      @relation("ProjectArchitectureVersions", fields: [projectId], references: [id], onDelete: Cascade)
  currentForProject Project?                     @relation("CurrentProjectArchitectureVersion")
  parentVersion     ProjectArchitectureVersion?  @relation("ProjectArchitectureVersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions     ProjectArchitectureVersion[] @relation("ProjectArchitectureVersionParent")
  contractVersion   ProjectContractVersion?      @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)
  sourceTask        Task?                        @relation("ArchitectureSourceTask", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  effectiveTasks    Task[]                       @relation("TaskEffectiveArchitecture")
  roadmapCycles     ProjectRoadmapCycle[]        @relation("RoadmapCycleArchitecture")

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@map("project_architecture_versions")
}

model ProjectImplementationStep {
  id                  String                          @id @default(uuid())
  projectId           String                          @map("project_id")
  cycleId             String                          @map("cycle_id")
  sequenceNumber      Int                             @map("sequence_number")
  title               String
  description         String
  acceptanceCriteria  Json                            @map("acceptance_criteria")
  requirementIds      Json                            @default("[]") @map("requirement_ids")
  deliverables        Json                            @default("[]")
  changeRationale     String                          @default("") @map("change_rationale")
  dependsOnStepTitles Json                            @default("[]") @map("depends_on_step_titles")
  validationFocus     Json                            @default("[]") @map("validation_focus")
  status              ProjectImplementationStepStatus @default(pending)
  taskId              String?                         @unique @map("task_id")
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")
  completedAt         DateTime?                       @map("completed_at")

  project            Project              @relation(fields: [projectId], references: [id])
  cycle              ProjectRoadmapCycle  @relation(fields: [cycleId], references: [id])
  task               Task?                @relation(fields: [taskId], references: [id])
  acceptanceEvidence AcceptanceEvidence[]

  @@unique([cycleId, sequenceNumber])
  @@index([projectId, status])
  @@map("project_implementation_steps")
}

model AcceptanceEvidence {
  id              String                   @id @default(uuid())
  projectId       String                   @map("project_id")
  cycleId         String                   @map("cycle_id")
  stepId          String?                  @map("step_id")
  taskId          String?                  @map("task_id")
  taskRunId       String?                  @map("task_run_id")
  requirementId   String                   @map("requirement_id")
  criterionKey    String                   @map("criterion_key")
  criterion       String
  source          AcceptanceEvidenceSource
  status          AcceptanceEvidenceStatus
  evidenceKey     String                   @map("evidence_key")
  contractVersion Int                      @map("contract_version")
  commitSha       String?                  @map("commit_sha")
  command         String?
  exitCode        Int?                     @map("exit_code")
  detailsUrl      String?                  @map("details_url")
  payloadJson     Json                     @map("payload_json")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  project Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycle   ProjectRoadmapCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  step    ProjectImplementationStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  task    Task?                      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskRun TaskRun?                   @relation(fields: [taskRunId], references: [id], onDelete: SetNull)

  @@unique([cycleId, requirementId, criterionKey, source, evidenceKey])
  @@index([projectId, cycleId, requirementId])
  @@index([taskId])
  @@map("acceptance_evidence")
}

model ProjectAuditJob {
  id             String                @id @default(uuid())
  projectId      String                @map("project_id")
  cycleId        String                @unique @map("cycle_id")
  triggerTaskId  String?               @map("trigger_task_id")
  requirementIds Json                  @default("[]") @map("requirement_ids")
  status         ProjectAuditJobStatus @default(pending)
  attemptCount   Int                   @default(0) @map("attempt_count")
  nextAttemptAt  DateTime?             @map("next_attempt_at")
  errorMessage   String?               @map("error_message")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  claimedAt      DateTime?             @map("claimed_at")
  finishedAt     DateTime?             @map("finished_at")

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycle   ProjectRoadmapCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@map("project_audit_jobs")
}

model TaskQueueJob {
  id            String         @id @default(uuid())
  taskId        String         @map("task_id")
  status        QueueJobStatus @default(pending)
  reason        String
  attemptCount  Int            @default(0) @map("attempt_count")
  nextAttemptAt DateTime?      @map("next_attempt_at")
  errorMessage  String?        @map("error_message")
  createdAt     DateTime       @default(now()) @map("created_at")
  claimedAt     DateTime?      @map("claimed_at")
  finishedAt    DateTime?      @map("finished_at")

  task Task @relation(fields: [taskId], references: [id])

  @@index([status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([taskId, status])
  @@map("task_queue_jobs")
}

model WorkerControl {
  id          String    @id
  queuePaused Boolean   @default(false) @map("queue_paused")
  pausedAt    DateTime? @map("paused_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("worker_control")
}

model TaskRun {
  id               String       @id @default(uuid())
  taskId           String       @map("task_id")
  provider         ProviderKind
  model            String
  status           RunStatus    @default(queued)
  iterationCount   Int          @default(0) @map("iteration_count")
  inputTokens      Int          @default(0) @map("input_tokens")
  outputTokens     Int          @default(0) @map("output_tokens")
  totalTokens      Int          @default(0) @map("total_tokens")
  usageSource      String       @default("estimated") @map("usage_source")
  estimatedCostUsd Decimal      @default(0.00) @map("estimated_cost_usd") @db.Decimal(10, 4)
  actualCostUsd    Decimal?     @map("actual_cost_usd") @db.Decimal(10, 4)
  startedAt        DateTime?    @map("started_at")
  finishedAt       DateTime?    @map("finished_at")
  summary          String?
  errorMessage     String?      @map("error_message")
  runStateJson     Json         @default("{\"version\":1,\"status\":\"queued\"}") @map("run_state_json")

  task               Task                 @relation(fields: [taskId], references: [id])
  iterations         TaskIteration[]
  providerUsage      ProviderUsage[]
  acceptanceEvidence AcceptanceEvidence[]
  checkpoints        TaskCheckpoint[]
  windowsExecutionJobs WindowsExecutionJob[]

  @@index([taskId, status])
  @@map("task_runs")
}

enum TaskCheckpointStatus {
  started
  completed
  failed
}

model TaskCheckpoint {
  id           String               @id @default(uuid())
  taskId       String               @map("task_id")
  taskRunId    String?              @map("task_run_id")
  key          String
  phase        String
  status       TaskCheckpointStatus @default(started)
  inputHash    String               @map("input_hash")
  outputJson   Json?                @map("output_json")
  errorMessage String?              @map("error_message")
  startedAt    DateTime             @default(now()) @map("started_at")
  completedAt  DateTime?            @map("completed_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskRun TaskRun? @relation(fields: [taskRunId], references: [id], onDelete: SetNull)

  @@unique([taskId, key])
  @@index([taskId, status])
  @@map("task_checkpoints")
}

model TaskIteration {
  id                   String         @id @default(uuid())
  taskRunId            String         @map("task_run_id")
  iterationNumber      Int            @map("iteration_number")
  phase                IterationPhase
  prompt               String
  resultSummary        String         @map("result_summary")
  providerPrompt       String?        @map("provider_prompt")
  providerResponse     String?        @map("provider_response")
  diffStatJson         Json           @map("diff_stat_json")
  validationResultJson Json           @map("validation_result_json")
  createdAt            DateTime       @default(now()) @map("created_at")

  taskRun TaskRun @relation(fields: [taskRunId], references: [id])

  @@unique([taskRunId, iterationNumber, phase])
  @@map("task_iterations")
}

model ProviderUsage {
  id               String       @id @default(uuid())
  taskId           String       @map("task_id")
  taskRunId        String       @map("task_run_id")
  provider         ProviderKind
  model            String
  phase            String?
  attempt          Int?
  inputTokens      Int          @default(0) @map("input_tokens")
  outputTokens     Int          @default(0) @map("output_tokens")
  cachedTokens     Int          @default(0) @map("cached_tokens")
  totalTokens      Int          @default(0) @map("total_tokens")
  usageSource      String       @default("estimated") @map("usage_source")
  credits          Decimal      @default(0.00) @db.Decimal(12, 4)
  estimatedCostUsd Decimal      @default(0.00) @map("estimated_cost_usd") @db.Decimal(10, 4)
  actualCostUsd    Decimal?     @map("actual_cost_usd") @db.Decimal(10, 4)
  createdAt        DateTime     @default(now()) @map("created_at")

  task    Task    @relation(fields: [taskId], references: [id])
  taskRun TaskRun @relation(fields: [taskRunId], references: [id])

  @@index([provider, createdAt])
  @@map("provider_usage")
}

model AuditLog {
  id           String         @id @default(uuid())
  actorType    AuditActorType @map("actor_type")
  actorId      String?        @map("actor_id")
  eventType    String         @map("event_type")
  projectId    String?        @map("project_id")
  taskId       String?        @map("task_id")
  chatThreadId String?        @map("chat_thread_id")
  chatRunId    String?        @map("chat_run_id")
  payload      Json           @map("payload_json")
  createdAt    DateTime       @default(now()) @map("created_at")

  project    Project?    @relation(fields: [projectId], references: [id])
  task       Task?       @relation(fields: [taskId], references: [id])
  chatThread ChatThread? @relation(fields: [chatThreadId], references: [id], onDelete: SetNull)
  chatRun    ChatRun?    @relation(fields: [chatRunId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([taskId, createdAt])
  @@index([chatThreadId, createdAt])
  @@index([chatRunId, createdAt])
  @@map("audit_log")
}
